---
import { Image } from 'astro:assets'

import SocialIcons from './SocialIcons.astro'


const {fullName, title, institute, profilePicture} = Astro.props
---
<div class='flex-1'>
  <h1 class='text-4xl font-bold mb-4'>
    Hi! I'm <span class='text-secondary'>{fullName}</span>
  </h1>
  <p class='text-xl text-base-content/70 mb-6'>{title}{institute ? ` at ${institute}` : ''}</p>
  <div class='text-lg mb-6 space-y-4 [&_a]:link [&_a]:link-hover [&_a]:text-secondary'>
    <slot />
  </div>
  <div class='flex gap-4 max-w-md'>
    <SocialIcons />
  </div>
</div>
<div class='size-72 lg:block hidden shrink-0'>
  <Image
    src={profilePicture}
    alt={`Portrait of ${fullName}`}
    class='w-full h-full mask mask-circle size-44'
  />
</div>
