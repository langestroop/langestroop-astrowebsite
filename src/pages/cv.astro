---
import Layout from '@/layouts/Layout.astro'
import { experiences, researchExperience, education, awards, skills, publications } from '../data/cv'
import CvTimeline from '@/components/ui/CvTimeline.astro'
import List from '@/components/ui/List.astro'
import PublicationsList from '@/components/ui/PublicationsList.astro'
import { profile } from '@/settings'

// Entries keep the order in which they are written in src/data/cv.ts (most recent first).
---

<Layout title={`CV | ${profile.fullName}`}>
	<h1 class='text-3xl font-bold mb-10'>Curriculum Vitae</h1>

	{
		experiences.length > 0 && (
			<section class='mb-12'>
				<h2 class='text-2xl font-bold mb-6 border-b pb-2'>
					Academic Positions
				</h2>
				<CvTimeline elements={experiences} colored={true} />
			</section>
		)
	}

	{
		education.length > 0 && (
			<section class='mb-12'>
				<h2 class='text-2xl font-bold mb-6 border-b pb-2'>
					Education
				</h2>
				<CvTimeline elements={education} colored={true} />
			</section>
		)
	}

	{
		researchExperience.length > 0 && (
			<section class='mb-12'>
				<h2 class='text-2xl font-bold mb-6 border-b pb-2'>
					Research Experience
				</h2>
				<CvTimeline elements={researchExperience} colored={true} />
			</section>
		)
	}

	{
		awards.length > 0 && (
			<section class='mb-12'>
				<h2 class='text-2xl font-bold mb-6 border-b pb-2'>
					Awards &amp; Honours
				</h2>
				<ul class='space-y-3'>
					{awards.map((award) => (
						<li class='flex gap-4'>
							<span class='font-mono text-base-content/70 w-12 shrink-0'>{award.time}</span>
							<span><span class='font-semibold'>{award.title}</span>, {award.institution}</span>
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		skills.length > 0 && (
			<section class='mb-12'>
				<List listTitle='Skills' listItems={skills}/>
			</section>
		)
	}

	{
		publications.length > 0 && (
			<section class='mb-12'>
				<h2 class='text-2xl font-bold mb-6 border-b pb-2'>
					Publications
				</h2>
				<PublicationsList elements={publications}/>
			</section>
		)
	}
</Layout>
